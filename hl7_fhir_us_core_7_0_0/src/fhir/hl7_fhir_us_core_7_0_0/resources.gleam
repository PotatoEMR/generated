pub fn us_core_organization_decoder() -> Decoder(UsCoreOrganization) {
  use <- decode.recursive
  use endpoint <- decode.optional_field(
    "endpoint",
    [],
    decode.list(ct.reference_decoder()),
  )
  use contact <- decode.optional_field(
    "contact",
    [],
    decode.list(us_core_organization_contact_decoder()),
  )
  use part_of <- decode.optional_field(
    "partOf",
    None,
    decode.optional(ct.reference_decoder()),
  )
  use address <- decode.optional_field(
    "address",
    [],
    decode.list(us_core_organization_address_decoder()),
  )
  use telecom <- decode.optional_field(
    "telecom",
    [],
    decode.list(ct.contactpoint_decoder()),
  )
  use alias <- decode.optional_field("alias", [], decode.list(decode.string))
  use name <- decode.field("name", decode.string)
  use type_ <- decode.optional_field(
    "type",
    [],
    decode.list(ct.codeableconcept_decoder()),
  )
  use active <- decode.field("active", decode.bool)
  use identifier_base_values <- decode.optional_field(
    "identifier",
    [],
    decode.list(us_core_organization_identifier_open_decoder()),
  )
  let identifier_accumulator =
    list.fold(
      identifier_base_values,
      Ok(UsCoreOrganizationIdentifierSliceAccumulator([], [], [], [])),
      fn(accumulator_result, identifier) {
        let parsed: Result(
          UsCoreOrganizationParsedIdentifierSlice,
          List(decode.DecodeError),
        ) = case
          case identifier.system {
            Some(value) ->
              case value == "urn:oid:2.16.840.1.113883.6.300" {
                True -> Ok(value)
                False -> Error(Nil)
              }
            None -> Error(Nil)
          }
        {
          Ok(_) ->
            Ok(
              UsCoreOrganizationParsedIdentifierSliceNaic(
                UsCoreOrganizationIdentifierNaic(
                  assigner: identifier.assigner,
                  period: identifier.period,
                  value: identifier.value,
                  type_: identifier.type_,
                  use_: identifier.use_,
                  extension: identifier.extension,
                  id: identifier.id,
                ),
              ),
            )
          Error(_) ->
            case
              case identifier.system {
                Some(value) ->
                  case value == "urn:oid:2.16.840.1.113883.4.7" {
                    True -> Ok(value)
                    False -> Error(Nil)
                  }
                None -> Error(Nil)
              }
            {
              Ok(_) ->
                Ok(
                  UsCoreOrganizationParsedIdentifierSliceClia(
                    UsCoreOrganizationIdentifierClia(
                      assigner: identifier.assigner,
                      period: identifier.period,
                      value: identifier.value,
                      type_: identifier.type_,
                      use_: identifier.use_,
                      extension: identifier.extension,
                      id: identifier.id,
                    ),
                  ),
                )
              Error(_) ->
                case
                  case identifier.system {
                    Some(value) ->
                      case value == "http://hl7.org/fhir/sid/us-npi" {
                        True -> Ok(value)
                        False -> Error(Nil)
                      }
                    None -> Error(Nil)
                  }
                {
                  Ok(_) ->
                    Ok(
                      UsCoreOrganizationParsedIdentifierSliceNpi(
                        UsCoreOrganizationIdentifierNpi(
                          assigner: identifier.assigner,
                          period: identifier.period,
                          value: identifier.value,
                          type_: identifier.type_,
                          use_: identifier.use_,
                          extension: identifier.extension,
                          id: identifier.id,
                        ),
                      ),
                    )
                  Error(_) ->
                    Ok(UsCoreOrganizationParsedIdentifierSliceOpen(identifier))
                }
            }
        }
        case accumulator_result, parsed {
          Ok(accumulator),
            Ok(UsCoreOrganizationParsedIdentifierSliceNaic(value))
          ->
            Ok(
              UsCoreOrganizationIdentifierSliceAccumulator(..accumulator, naic: [
                value,
                ..accumulator.naic
              ]),
            )
          Ok(accumulator),
            Ok(UsCoreOrganizationParsedIdentifierSliceClia(value))
          ->
            Ok(
              UsCoreOrganizationIdentifierSliceAccumulator(..accumulator, clia: [
                value,
                ..accumulator.clia
              ]),
            )
          Ok(accumulator), Ok(UsCoreOrganizationParsedIdentifierSliceNpi(value))
          ->
            Ok(
              UsCoreOrganizationIdentifierSliceAccumulator(..accumulator, npi: [
                value,
                ..accumulator.npi
              ]),
            )
          Ok(accumulator),
            Ok(UsCoreOrganizationParsedIdentifierSliceOpen(value))
          ->
            Ok(
              UsCoreOrganizationIdentifierSliceAccumulator(..accumulator, open: [
                value,
                ..accumulator.open
              ]),
            )
          Ok(_), Error(errors) -> Error(errors)
          Error(errors), Ok(_) -> Error(errors)
          Error(errors), Error(new_errors) ->
            Error(list.append(new_errors, errors))
        }
      },
    )
  let identifier_slices = case identifier_accumulator {
    Ok(accumulator) ->
      Ok(UsCoreOrganizationIdentifierSlices(
        naic: list.reverse(accumulator.naic),
        clia: list.reverse(accumulator.clia),
        npi: list.reverse(accumulator.npi),
        open: list.reverse(accumulator.open),
      ))
    Error(errors) -> Error(errors)
  }
  let identifier_slices_decoder = case identifier_slices {
    Ok(identifier_slices) -> decode.success(identifier_slices)
    Error(errors) ->
      decode.failure(
        UsCoreOrganizationIdentifierSlices(
          naic: [],
          clia: [],
          npi: [],
          open: [],
        ),
        "UsCoreOrganization slices",
      )
      |> decode.map_errors(fn(_) { errors })
  }
  use modifier_extension <- decode.optional_field(
    "modifierExtension",
    [],
    decode.list(ct.extension_decoder()),
  )
  use extension <- decode.optional_field(
    "extension",
    [],
    decode.list(ct.extension_decoder()),
  )
  use contained <- decode.optional_field(
    "contained",
    [],
    decode.list(resource_decoder()),
  )
  use text <- decode.optional_field(
    "text",
    None,
    decode.optional(ct.narrative_decoder()),
  )
  use language <- decode.optional_field(
    "language",
    None,
    decode.optional(decode.string),
  )
  use implicit_rules <- decode.optional_field(
    "implicitRules",
    None,
    decode.optional(decode.string),
  )
  use meta <- decode.optional_field(
    "meta",
    None,
    decode.optional(ct.meta_decoder()),
  )
  use id <- decode.optional_field("id", None, decode.optional(decode.string))
  use _ <- decode.field(
    "resourceType",
    decode.then(decode.string, fn(resource_type) {
      case resource_type {
        "Organization" -> decode.success(resource_type)
        _ -> decode.failure(resource_type, "Organization")
      }
    }),
  )
  use identifier_slices <- decode.then(identifier_slices_decoder)
  let UsCoreOrganizationIdentifierSlices(naic:, clia:, npi:, open: identifier) =
    identifier_slices
  decode.success(UsCoreOrganization(
    endpoint:,
    contact:,
    part_of:,
    address:,
    telecom:,
    alias:,
    name:,
    type_:,
    active:,
    naic:,
    clia:,
    npi:,
    identifier:,
    modifier_extension:,
    extension:,
    contained:,
    text:,
    language:,
    implicit_rules:,
    meta:,
    id:,
  ))
}

