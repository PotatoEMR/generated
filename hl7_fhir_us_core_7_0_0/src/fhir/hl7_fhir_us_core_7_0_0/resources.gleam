  )
  use id <- decode.optional_field("id", None, decode.optional(decode.string))
  use _ <- decode.field(
    "resourceType",
    decode.then(decode.string, fn(resource_type) {
      case resource_type {
        "DocumentReference" -> decode.success(resource_type)
        _ -> decode.failure(resource_type, "DocumentReference")
      }
    }),
  )
  use category_slices <- decode.then(category_slices_decoder)
  let category = category_slices
  decode.success(UsCoreDocumentreference(
