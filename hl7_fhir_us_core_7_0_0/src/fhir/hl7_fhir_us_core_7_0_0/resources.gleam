              Ok(matched) ->
                Ok(
                  UsCoreProvenanceAgentProvenanceauthorSlice(
                    UsCoreProvenanceAgentProvenanceauthor(
                      on_behalf_of: agent.on_behalf_of,
                      who: agent.who,
                      role: agent.role,
                      type_: matched,
                      modifier_extension: agent.modifier_extension,
                      extension: agent.extension,
                      id: agent.id,
                    ),
                  ),
                )
              Error(_) -> Ok(UsCoreProvenanceAgentOpenSlice(agent))
            }
        }
        case accumulator_result, parsed {
          Ok(accumulator), Ok(value) ->
            Ok(
              UsCoreProvenanceAgentSliceAccumulator([
                value,
                ..accumulator.values
