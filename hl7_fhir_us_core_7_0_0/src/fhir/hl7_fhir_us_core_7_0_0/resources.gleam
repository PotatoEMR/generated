    decode.list(ct.reference_decoder()),
  )
  use issued <- decode.optional_field(
    "issued",
    None,
    decode.optional(pt.instant_decoder()),
  )
  use effective <- decode.then(us_core_pulse_oximetry_effective_decoder())
  use encounter <- decode.optional_field(
    "encounter",
    None,
    decode.optional(ct.reference_decoder()),
  )
  use focus <- decode.optional_field(
    "focus",
    [],
    decode.list(ct.reference_decoder()),
  )
  use subject <- decode.field("subject", ct.reference_decoder())
  use code <- decode.field("code", us_core_pulse_oximetry_code_decoder())
  use category_base_values <- decode.optional_field(
    "category",
    [],
    decode.list(ct.codeableconcept_decoder()),
  )
  let category_accumulator =
    list.fold(
      category_base_values,
      Ok(UsCorePulseOximetryCategorySliceAccumulator([], [])),
      fn(accumulator_result, category) {
        let parsed: Result(
          UsCorePulseOximetryParsedCategorySlice,
          List(decode.DecodeError),
        ) = case
          ct.codeableconcept_fixed_system_code_from_codeableconcept(
            category,
            "http://terminology.hl7.org/CodeSystem/observation-category",
            "vital-signs",
          )
        {
          Ok(matched) ->
            Ok(UsCorePulseOximetryParsedCategorySliceVscat(matched))
          Error(_) -> Ok(UsCorePulseOximetryParsedCategorySliceOpen(category))
        }
        case accumulator_result, parsed {
          Ok(accumulator),
            Ok(UsCorePulseOximetryParsedCategorySliceVscat(value))
          ->
            Ok(
              UsCorePulseOximetryCategorySliceAccumulator(..accumulator, vscat: [
                value,
                ..accumulator.vscat
              ]),
            )
          Ok(accumulator), Ok(UsCorePulseOximetryParsedCategorySliceOpen(value))
          ->
            Ok(
              UsCorePulseOximetryCategorySliceAccumulator(..accumulator, open: [
                value,
                ..accumulator.open
              ]),
            )
          Ok(_), Error(errors) -> Error(errors)
          Error(errors), Ok(_) -> Error(errors)
          Error(errors), Error(new_errors) ->
            Error(list.append(new_errors, errors))
        }
      },
    )
  let category_slices = case category_accumulator {
    Ok(accumulator) -> {
      let vscat = case list.reverse(accumulator.vscat) {
        [value, ..] -> Ok(value)
        [] ->
          Error([
            decode.DecodeError(
              expected: "1 VSCat category",
              found: "0 VSCat categorys",
              path: ["category", "VSCat"],
            ),
          ])
      }
      case vscat {
        Ok(vscat) ->
          Ok(UsCorePulseOximetryCategorySlices(
            vscat:,
            open: list.reverse(accumulator.open),
          ))
        Error(errors) -> Error(errors)
      }
    }
    Error(errors) -> Error(errors)
  }
  let category_slices_decoder = case category_slices {
    Ok(category_slices) -> decode.success(category_slices)
    Error(errors) ->
      decode.failure(
        UsCorePulseOximetryCategorySlices(
          vscat: ct.codeableconcept_fixed_system_code_new(),
          open: [],
        ),
        "UsCorePulseOximetry slices",
      )
      |> decode.map_errors(fn(_) { errors })
  }
