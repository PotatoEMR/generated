              ),
            )
          Error(_) -> Ok(UsCorePractitionerIdentifierComponentOpen(identifier))
        }
        case accumulator_result, parsed {
          Ok(accumulator), Ok(value) ->
            Ok(
              UsCorePractitionerIdentifierComponentSliceAccumulator([
                value,
