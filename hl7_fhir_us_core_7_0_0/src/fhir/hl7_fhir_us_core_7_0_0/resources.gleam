  use category_base_values <- decode.optional_field(
    "category",
    [],
    decode.list(ct.codeableconcept_decoder()),
  )
  let category_accumulator =
    list.fold(
      category_base_values,
      Ok(UsCoreServicerequestCategorySliceAccumulator([], [])),
      fn(accumulator_result, category) {
        let parsed: Result(
          UsCoreServicerequestParsedCategorySlice,
          List(decode.DecodeError),
        ) = case
          ct.bound_codeableconcept_from_codeableconcept(
            category,
            valuesets.uscoreservicerequestcategory_from_code_and_system,
          )
        {
          Ok(matched) ->
            Ok(UsCoreServicerequestParsedCategorySliceUsCore(matched))
          Error(_) -> Ok(UsCoreServicerequestParsedCategorySliceOpen(category))
        }
        case accumulator_result, parsed {
          Ok(accumulator),
            Ok(UsCoreServicerequestParsedCategorySliceUsCore(value))
          ->
            Ok(
              UsCoreServicerequestCategorySliceAccumulator(
                ..accumulator,
                uscore: [value, ..accumulator.uscore],
              ),
            )
          Ok(accumulator),
            Ok(UsCoreServicerequestParsedCategorySliceOpen(value))
          ->
            Ok(
              UsCoreServicerequestCategorySliceAccumulator(..accumulator, open: [
                value,
                ..accumulator.open
              ]),
            )
          Ok(_), Error(errors) -> Error(errors)
          Error(errors), Ok(_) -> Error(errors)
          Error(errors), Error(new_errors) ->
            Error(list.append(new_errors, errors))
        }
      },
    )
  let category_slices = case category_accumulator {
    Ok(accumulator) ->
      Ok(UsCoreServicerequestCategorySlices(
        uscore: list.reverse(accumulator.uscore),
        open: list.reverse(accumulator.open),
      ))
    Error(errors) -> Error(errors)
  }
  let category_slices_decoder = case category_slices {
    Ok(category_slices) -> decode.success(category_slices)
    Error(errors) ->
      decode.failure(
        UsCoreServicerequestCategorySlices(uscore: [], open: []),
        "UsCoreServicerequest slices",
      )
      |> decode.map_errors(fn(_) { errors })
  }
  use intent <- decode.field("intent", valuesets.requestintent_decoder())
  use status <- decode.field("status", valuesets.requeststatus_decoder())
  use requisition <- decode.optional_field(
    "requisition",
    None,
    decode.optional(ct.identifier_decoder()),
  )
  use replaces <- decode.optional_field(
    "replaces",
    [],
