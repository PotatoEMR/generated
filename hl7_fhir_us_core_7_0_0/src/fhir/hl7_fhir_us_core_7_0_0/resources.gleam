pub fn us_core_bmi_decoder() -> Decoder(UsCoreBmi) {
  use <- decode.recursive
  use component <- decode.optional_field(
    "component",
    [],
    decode.list(us_core_bmi_component_decoder()),
  )
  use derived_from <- decode.optional_field(
    "derivedFrom",
    [],
    decode.list(ct.reference_decoder()),
  )
  use has_member <- decode.optional_field(
    "hasMember",
    [],
    decode.list(ct.reference_decoder()),
