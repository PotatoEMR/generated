pub fn us_core_careplan_decoder() -> Decoder(UsCoreCareplan) {
  use <- decode.recursive
  use note <- decode.optional_field(
    "note",
    [],
    decode.list(ct.annotation_decoder()),
  )
  use activity <- decode.optional_field(
    "activity",
    [],
    decode.list(us_core_careplan_activity_decoder()),
  )
  use goal <- decode.optional_field(
    "goal",
    [],
    decode.list(ct.reference_decoder()),
  )
  use supporting_info <- decode.optional_field(
    "supportingInfo",
    [],
    decode.list(ct.reference_decoder()),
  )
  use addresses <- decode.optional_field(
    "addresses",
    [],
    decode.list(ct.reference_decoder()),
  )
  use care_team <- decode.optional_field(
    "careTeam",
    [],
    decode.list(ct.reference_decoder()),
  )
  use contributor <- decode.optional_field(
    "contributor",
    [],
    decode.list(ct.reference_decoder()),
  )
  use author <- decode.optional_field(
    "author",
    None,
    decode.optional(ct.reference_decoder()),
  )
  use created <- decode.optional_field(
    "created",
    None,
    decode.optional(pt.datetime_decoder()),
  )
  use period <- decode.optional_field(
    "period",
    None,
    decode.optional(ct.period_decoder()),
  )
  use encounter <- decode.optional_field(
    "encounter",
    None,
    decode.optional(ct.reference_decoder()),
  )
  use subject <- decode.field("subject", ct.reference_decoder())
  use description <- decode.optional_field(
    "description",
    None,
    decode.optional(decode.string),
  )
  use title <- decode.optional_field(
    "title",
    None,
    decode.optional(decode.string),
  )
  use category_base_values <- decode.optional_field(
    "category",
    [],
    decode.list(ct.codeableconcept_decoder()),
  )
  let category_accumulator =
    list.fold(
      category_base_values,
      Ok(UsCoreCareplanCategorySliceAccumulator([], [])),
      fn(accumulator_result, category) {
        let parsed: Result(
          UsCoreCareplanParsedCategorySlice,
          List(decode.DecodeError),
        ) = case
          ct.codeableconcept_fixed_system_code_from_codeableconcept(
            category,
            "http://hl7.org/fhir/us/core/CodeSystem/careplan-category",
            "assess-plan",
          )
        {
          Ok(matched) ->
            Ok(UsCoreCareplanParsedCategorySliceAssessplan(matched))
          Error(_) -> Ok(UsCoreCareplanParsedCategorySliceOpen(category))
        }
        case accumulator_result, parsed {
          Ok(accumulator),
            Ok(UsCoreCareplanParsedCategorySliceAssessplan(value))
          ->
            Ok(
              UsCoreCareplanCategorySliceAccumulator(
                ..accumulator,
                assess_plan: [value, ..accumulator.assess_plan],
              ),
            )
          Ok(accumulator), Ok(UsCoreCareplanParsedCategorySliceOpen(value)) ->
            Ok(
              UsCoreCareplanCategorySliceAccumulator(..accumulator, open: [
                value,
                ..accumulator.open
              ]),
            )
          Ok(_), Error(errors) -> Error(errors)
          Error(errors), Ok(_) -> Error(errors)
          Error(errors), Error(new_errors) ->
            Error(list.append(new_errors, errors))
        }
      },
    )
  let category_slices = case category_accumulator {
    Ok(accumulator) -> {
      let assess_plan = case list.reverse(accumulator.assess_plan) {
        [value, ..] -> Ok(value)
        [] ->
          Error([
            decode.DecodeError(
              expected: "1 AssessPlan category",
              found: "0 AssessPlan categorys",
              path: ["category", "AssessPlan"],
            ),
          ])
      }
      case assess_plan {
        Ok(assess_plan) ->
          Ok(UsCoreCareplanCategorySlices(
            assess_plan:,
            open: list.reverse(accumulator.open),
          ))
        Error(errors) -> Error(errors)
      }
    }
    Error(errors) -> Error(errors)
  }
  let category_slices_decoder = case category_slices {
    Ok(category_slices) -> decode.success(category_slices)
    Error(errors) ->
      decode.failure(
        UsCoreCareplanCategorySlices(
          assess_plan: ct.codeableconcept_fixed_system_code_new(),
          open: [],
        ),
        "UsCoreCareplan slices",
      )
      |> decode.map_errors(fn(_) { errors })
  }
  use intent <- decode.field("intent", valuesets.careplanintent_decoder())
  use status <- decode.field("status", valuesets.requeststatus_decoder())
  use part_of <- decode.optional_field(
    "partOf",
    [],
    decode.list(ct.reference_decoder()),
  )
  use replaces <- decode.optional_field(
    "replaces",
    [],
    decode.list(ct.reference_decoder()),
  )
  use based_on <- decode.optional_field(
    "basedOn",
    [],
    decode.list(ct.reference_decoder()),
  )
  use instantiates_uri <- decode.optional_field(
    "instantiatesUri",
    [],
    decode.list(decode.string),
  )
  use instantiates_canonical <- decode.optional_field(
    "instantiatesCanonical",
    [],
    decode.list(decode.string),
  )
  use identifier <- decode.optional_field(
    "identifier",
    [],
    decode.list(ct.identifier_decoder()),
  )
  use modifier_extension <- decode.optional_field(
    "modifierExtension",
    [],
    decode.list(ct.extension_decoder()),
  )
  use extension <- decode.optional_field(
    "extension",
    [],
    decode.list(ct.extension_decoder()),
  )
  use contained <- decode.optional_field(
    "contained",
    [],
    decode.list(resource_decoder()),
  )
  use text <- decode.optional_field(
    "text",
    None,
    decode.optional(ct.narrative_decoder()),
  )
  use language <- decode.optional_field(
    "language",
    None,
    decode.optional(decode.string),
  )
  use implicit_rules <- decode.optional_field(
    "implicitRules",
    None,
    decode.optional(decode.string),
  )
  use meta <- decode.optional_field(
    "meta",
    None,
    decode.optional(ct.meta_decoder()),
  )
  use id <- decode.optional_field("id", None, decode.optional(decode.string))
  use _ <- decode.field(
    "resourceType",
    decode.then(decode.string, fn(resource_type) {
      case resource_type {
        "CarePlan" -> decode.success(resource_type)
        _ -> decode.failure(resource_type, "CarePlan")
      }
    }),
  )
  use category_slices <- decode.then(category_slices_decoder)
  let UsCoreCareplanCategorySlices(assess_plan:, open: category) =
    category_slices
  decode.success(UsCoreCareplan(
    note:,
    activity:,
    goal:,
    supporting_info:,
    addresses:,
    care_team:,
    contributor:,
    author:,
    created:,
    period:,
    encounter:,
    subject:,
    description:,
    title:,
    assess_plan:,
    category:,
    intent:,
    status:,
    part_of:,
    replaces:,
    based_on:,
    instantiates_uri:,
    instantiates_canonical:,
    identifier:,
    modifier_extension:,
    extension:,
    contained:,
    text:,
    language:,
    implicit_rules:,
    meta:,
    id:,
  ))
}

