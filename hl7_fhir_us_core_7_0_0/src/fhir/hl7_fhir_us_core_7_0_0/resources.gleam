      list.map(category, fn(value) { ct.codeableconcept_to_json(value) }),
    ])
  let fields = case slice_values {
    [] -> fields
    values -> [#("category", json.preprocessed_array(values)), ..fields]
  }
  let fields = case requisition {
    Some(v) -> [#("requisition", ct.identifier_to_json(v)), ..fields]
    None -> fields
  }
  let fields = case replaces {
    [] -> fields
    values -> [
      #("replaces", json.array(values, ct.reference_to_json)),
      ..fields
    ]
  }
  let fields = case based_on {
    [] -> fields
    values -> [#("basedOn", json.array(values, ct.reference_to_json)), ..fields]
  }
  let fields = case instantiates_uri {
    [] -> fields
    values -> [#("instantiatesUri", json.array(values, json.string)), ..fields]
  }
  let fields = case instantiates_canonical {
    [] -> fields
    values -> [
      #("instantiatesCanonical", json.array(values, json.string)),
      ..fields
    ]
  }
  let fields = case identifier {
    [] -> fields
    values -> [
      #("identifier", json.array(values, ct.identifier_to_json)),
      ..fields
    ]
  }
  let fields = case modifier_extension {
    [] -> fields
    values -> [
      #("modifierExtension", json.array(values, ct.extension_to_json)),
      ..fields
    ]
  }
  let fields = case extension {
    [] -> fields
    values -> [
      #("extension", json.array(values, ct.extension_to_json)),
      ..fields
    ]
  }
  let fields = case contained {
    [] -> fields
    values -> [#("contained", json.array(values, resource_to_json)), ..fields]
  }
  let fields = case text {
    Some(v) -> [#("text", ct.narrative_to_json(v)), ..fields]
    None -> fields
  }
  let fields = case language {
    Some(v) -> [#("language", json.string(v)), ..fields]
    None -> fields
  }
  let fields = case implicit_rules {
    Some(v) -> [#("implicitRules", json.string(v)), ..fields]
    None -> fields
  }
  let fields = case meta {
    Some(v) -> [#("meta", ct.meta_to_json(v)), ..fields]
    None -> fields
  }
  let fields = case id {
    Some(v) -> [#("id", json.string(v)), ..fields]
    None -> fields
  }
  let fields = [#("resourceType", json.string("ServiceRequest")), ..fields]
  json.object(fields)
}

