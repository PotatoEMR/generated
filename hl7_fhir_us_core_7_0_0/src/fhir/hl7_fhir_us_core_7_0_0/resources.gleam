            Ok(
              UsCoreProvenanceAgentProvenancetransmitterSlice(
                UsCoreProvenanceAgentProvenancetransmitter(
                  on_behalf_of: agent.on_behalf_of,
                  who: agent.who,
                  role: agent.role,
                  type_: matched,
                  modifier_extension: agent.modifier_extension,
                  extension: agent.extension,
                  id: agent.id,
                ),
              ),
            )
          Error(_) ->
            case
              case agent.type_ {
                Some(value) ->
                  ct.codeableconcept_fixed_system_code_from_codeableconcept(
                    value,
                    "http://terminology.hl7.org/CodeSystem/provenance-participant-type",
                    "author",
