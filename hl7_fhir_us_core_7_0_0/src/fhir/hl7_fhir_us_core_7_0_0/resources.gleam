    "referenceRange",
    [],
    decode.list(us_core_bmi_referencerange_decoder()),
  )
  use device <- decode.optional_field(
    "device",
    None,
    decode.optional(ct.reference_decoder()),
  )
  use specimen <- decode.optional_field(
    "specimen",
    None,
    decode.optional(ct.reference_decoder()),
  )
  use method <- decode.optional_field(
    "method",
    None,
    decode.optional(ct.codeableconcept_decoder()),
  )
  use body_site <- decode.optional_field(
    "bodySite",
    None,
    decode.optional(ct.codeableconcept_decoder()),
  )
  use note <- decode.optional_field(
    "note",
    [],
    decode.list(ct.annotation_decoder()),
  )
  use interpretation <- decode.optional_field(
    "interpretation",
    [],
    decode.list(ct.codeableconcept_decoder()),
  )
  use data_absent_reason <- decode.optional_field(
