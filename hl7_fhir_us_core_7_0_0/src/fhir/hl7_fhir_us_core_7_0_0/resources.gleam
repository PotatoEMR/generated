    [],
    decode.list(ct.codeableconcept_decoder()),
  )
  let category_accumulator =
    list.fold(
      category_base_values,
      Ok(UsCoreDocumentreferenceCategorySliceAccumulator([])),
      fn(accumulator_result, category) {
        let parsed: Result(
          UsCoreDocumentreferenceCategory,
          List(decode.DecodeError),
        ) = case
          ct.bound_codeableconcept_from_codeableconcept(
            category,
            valuesets.uscoredocumentreferencecategory_from_code_and_system,
          )
        {
          Ok(matched) -> Ok(UsCoreDocumentreferenceCategoryUscore(matched))
          Error(_) -> Ok(UsCoreDocumentreferenceCategoryOpen(category))
        }
        case accumulator_result, parsed {
          Ok(accumulator), Ok(value) ->
            Ok(
              UsCoreDocumentreferenceCategorySliceAccumulator([
                value,
                ..accumulator.values
              ]),
            )
          Ok(_), Error(errors) -> Error(errors)
          Error(errors), Ok(_) -> Error(errors)
          Error(errors), Error(new_errors) ->
            Error(list.append(new_errors, errors))
        }
      },
    )
  let category_slices = case category_accumulator {
    Ok(UsCoreDocumentreferenceCategorySliceAccumulator(values:)) ->
      case list.reverse(values) {
        [first, ..rest] -> Ok(ct.List1(first:, rest:))
        [] ->
          Error([
            decode.DecodeError(
              expected: "at least 1 category",
              found: int.to_string(list.length(list.reverse(values)))
                <> " categorys",
              path: ["category"],
