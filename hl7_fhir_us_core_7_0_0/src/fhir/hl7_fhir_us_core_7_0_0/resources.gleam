type UsCoreMedicationAdherenceExtensionAccumulator {
  UsCoreMedicationAdherenceExtensionAccumulator(
    information_source: List(ct.Codeableconcept),
    date_asserted: Option(DateTime),
    medication_adherence: Option(ct.Codeableconcept),
    open: List(ct.Extension),
  )
}

fn parse_us_core_medication_adherence(
  extension: ct.Extension,
) -> Result(ct.UsCoreMedicationAdherence, String) {
  case extension.ext {
    ct.ExtComplex(children) -> {
      let accumulator: Result(
        UsCoreMedicationAdherenceExtensionAccumulator,
        String,
      ) =
        list.fold(
          children,
          Ok(UsCoreMedicationAdherenceExtensionAccumulator([], None, None, [])),
          fn(accumulator_result, child) {
            case accumulator_result {
              Error(reason) -> Error(reason)
              Ok(accumulator) ->
                case child.url {
                  "informationSource" ->
                    case child.ext {
                      ct.ExtSimple(ct.ExtensionValueCodeableconcept(value)) ->
                        Ok(
                          UsCoreMedicationAdherenceExtensionAccumulator(
                            ..accumulator,
                            information_source: [
                              value,
                              ..accumulator.information_source
                            ],
                          ),
                        )
                      _ ->
                        Error("extension informationSource has invalid value")
                    }
                  "dateAsserted" ->
                    case child.ext {
                      ct.ExtSimple(ct.ExtensionValueDatetime(value)) ->
                        Ok(
                          UsCoreMedicationAdherenceExtensionAccumulator(
                            ..accumulator,
                            date_asserted: Some(value),
                          ),
                        )
                      _ -> Error("extension dateAsserted has invalid value")
                    }
                  "medicationAdherence" ->
                    case child.ext {
                      ct.ExtSimple(ct.ExtensionValueCodeableconcept(value)) ->
                        Ok(
                          UsCoreMedicationAdherenceExtensionAccumulator(
                            ..accumulator,
                            medication_adherence: Some(value),
                          ),
                        )
                      _ ->
                        Error("extension medicationAdherence has invalid value")
                    }
                  _ ->
                    Ok(
                      UsCoreMedicationAdherenceExtensionAccumulator(
                        ..accumulator,
                        open: [child, ..accumulator.open],
                      ),
                    )
                }
            }
          },
        )
      case accumulator {
        Error(reason) -> Error(reason)
        Ok(accumulator) ->
          case accumulator.date_asserted {
            None -> Error("required extension date_asserted")
            Some(date_asserted) ->
              case accumulator.medication_adherence {
                None -> Error("required extension medication_adherence")
                Some(medication_adherence) ->
                  Ok(ct.UsCoreMedicationAdherence(
                    extension: list.reverse(accumulator.open),
                    information_source: list.reverse(
                      accumulator.information_source,
                    ),
                    date_asserted:,
                    medication_adherence:,
                  ))
              }
          }
      }
    }
    _ -> Error("extension should contain child extensions")
  }
}

