    decode.optional(pt.instant_decoder()),
  )
  use effective <- decode.then(us_core_bmi_effective_decoder())
  use encounter <- decode.optional_field(
    "encounter",
    None,
    decode.optional(ct.reference_decoder()),
  )
  use focus <- decode.optional_field(
