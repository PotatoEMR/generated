  }
  let agent_slices_decoder = case agent_slices {
    Ok(agent_slices) -> decode.success(agent_slices)
    Error(errors) ->
      decode.failure(
        ct.List1(
          first: UsCoreProvenanceAgentOpenSlice(
            us_core_provenance_agent_open_new(who: ct.reference_new()),
