    None,
    decode.optional(ct.codeableconcept_decoder()),
  )
  use value <- decode.then(none_if_omitted(us_core_bmi_value_decoder()))
  use performer <- decode.optional_field(
    "performer",
    [],
    decode.list(ct.reference_decoder()),
  )
  use issued <- decode.optional_field(
    "issued",
