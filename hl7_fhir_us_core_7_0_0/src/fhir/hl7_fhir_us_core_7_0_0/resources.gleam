          UsCorePractitionerIdentifierComponent,
          List(decode.DecodeError),
        ) = case
          case identifier.system == "http://hl7.org/fhir/sid/us-npi" {
            True -> Ok(identifier.system)
            False -> Error(Nil)
          }
